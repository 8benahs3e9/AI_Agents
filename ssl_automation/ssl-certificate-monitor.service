[Unit]
Description=SSL Certificate Monitoring Service
Documentation=https://letsencrypt.org/docs/
After=network.target nginx.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/user/AI_Agents/ssl_automation
ExecStart=/home/user/AI_Agents/ssl_automation/ssl_monitor.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ssl-certificate-monitor

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log /etc/letsencrypt /var/lib/letsencrypt

[Install]
WantedBy=multi-user.target